# 复制本文件为 .env（和 app.py 放在同一个文件夹），再填写。.env 里有密钥，不要发给别人、不要上传。

# ========== 大模型（必填才能用“真实大模型”模式）==========
# 任何兼容 OpenAI 格式的接口都可以，下面是 DeepSeek 的写法
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash

# DeepSeek 思考模式默认开启；思考模式 + 工具调用需要回传 reasoning_content，
# LangChain 的 ChatOpenAI 不会回传，会报 HTTP 400，所以这里默认关闭思考模式。
# 换成其他模型服务商时，如果对方不认识这个参数，把这一行改成 LLM_EXTRA_BODY={}
LLM_EXTRA_BODY={"thinking": {"type": "disabled"}}

# 强制模型每次都调用工具（required）。如果模型服务不支持，改成 auto
LLM_TOOL_CHOICE=required
LLM_TIMEOUT=60

# ========== 嵌入模型（向量检索用，可选）==========
# fastembed = 本机小模型 BAAI/bge-small-zh-v1.5，首次运行自动下载约 90MB，不花钱
# openai    = 兼容 OpenAI 格式的嵌入接口（需填下面三项）
# none      = 不用向量检索，只用 BM25 关键词检索
EMBEDDING_PROVIDER=fastembed
# EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY=

# 国内下载 HuggingFace 模型慢或失败时，打开下面这行用镜像
# HF_ENDPOINT=https://hf-mirror.com
